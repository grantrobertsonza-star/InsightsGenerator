# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local state
supabase/.temp
supabase/.branches

# Backups hold client data: never commit
/backups/

# timing log written by the report extraction step
extract-timing.log

# Local verification retains synthetic dumps/profiles and temporary service keys outside Git.
**/__pycache__/
*.pyc
*.bak
*.log
/*.pptx
/.chk.lint
/_*.mts
/_*.py
/_to_delete/
/supabase/snippets/
/scripts/**/runs/
/scripts/**/executed-harness/
/scripts/**/*.zip
/scripts/.obj_rev_009_tmp/
/scripts/.imp_ship_trace_tmp*/

# browser smoke output (scripts/e2e/local-stack.mjs, playwright.config.mjs)
/e2e-results/
/e2e-results-*/
